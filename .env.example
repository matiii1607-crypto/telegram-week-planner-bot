# Token que te da @BotFather en Telegram al crear el bot
TELEGRAM_BOT_TOKEN=

# API key gratuita de https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Tu ID numérico de usuario de Telegram (habla con @userinfobot para obtenerlo).
# Si lo configuras, el bot SOLO responderá a este usuario (recomendado,
# porque el bot tiene acceso a tu calendario).
ALLOWED_TELEGRAM_USER_ID=

# Zona horaria IANA, ej: America/Argentina/Buenos_Aires, America/Mexico_City, Europe/Madrid
TIMEZONE=America/Argentina/Buenos_Aires

# ID del calendario de Google a usar. "primary" es tu calendario principal.
GOOGLE_CALENDAR_ID=primary

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-flash-lite-latest

# --- Solo necesarias en la PC local, para refresh_google_token.py.
# --- NO se configuran en Render (Render no necesita acceder a su propia API).
# API key de Render: dashboard.render.com -> Account Settings -> API Keys
RENDER_API_KEY=
# ID del servicio (está en la URL del dashboard: dashboard.render.com/web/srv-XXXXX)
RENDER_SERVICE_ID=
